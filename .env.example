# ─── Curify AI Advisor — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Gemini LLM ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Curify AI Advisor"
APP_VERSION="1.0.0"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ── API Security ──────────────────────────────────────────────────────────────
TRAIN_API_KEY=change_me_to_a_strong_random_string_32chars
CHATBOT_API_KEY=change_me_to_a_strong_random_string_32chars

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./curify_chat.db

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=curify_knowledge

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Classifier ────────────────────────────────────────────────────────────────
MODEL_DIR=./models/saved
CONFIDENCE_THRESHOLD=0.6
TOP_K_RETRIEVAL=3

# ── Training Data ─────────────────────────────────────────────────────────────
TRAINING_DATA_PATH=./data/raw/sample_training_data.csv

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for Flutter / web clients
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:4200

# ── LLM Response Cache ────────────────────────────────────────────────────────
LLM_CACHE_MAX_SIZE=256
LLM_CACHE_TTL_SECONDS=300

# ── Retrain Script ────────────────────────────────────────────────────────────
MIN_NEW_SAMPLES_FOR_RETRAIN=10
